GEMINI_API_KEY=your_gemini_api_key_here
APP_SHARED_SECRET=choose_a_long_random_string_here
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000

# Admin-only secret for seeding real PYQ questions (never used by the app itself)
ADMIN_SECRET=choose_a_different_long_random_string_here

# Max Gemini quiz-generation calls allowed per day (keeps free tier safe)
MAX_AI_GENERATIONS_PER_DAY=30

# Paste your Firebase service account JSON here as ONE LINE (see setup steps)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","...":"..."}
